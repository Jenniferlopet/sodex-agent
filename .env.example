# Netlify
NODE_VERSION=20
LIVE_TRADING=false

# Market data from ENV. If SoSoValue fails, the function silently falls back to CoinGecko, then Binance.
SOSOVALUE_API_KEY=
SOSOVALUE_MARKET_URL=
SOSOVALUE_API_HEADER_NAME=X-API-Key
SOSOVALUE_AUTH_MODE=header
COINGECKO_API_KEY=
COINGECKO_IDS=bitcoin,ethereum,solana,chainlink,arbitrum
BINANCE_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,LINKUSDT,ARBUSDT
MARKET_LIMIT=8
PROVIDER_TIMEOUT_MS=9000

# SoDEX data from ENV
SODEX_ENV=testnet
SODEX_API_BASE_URL=
SODEX_API_KEY_NAME=
SODEX_API_KEY=
SODEX_API_HEADER_NAME=X-API-Key
SODEX_ACCOUNT_ID=
SODEX_MARKETS_PATH=/api/markets
SODEX_ORDERBOOK_PATH=/api/orderbook?symbol={symbol}
SODEX_ACCOUNT_PATH=
DEFAULT_SODEX_SYMBOL=BTC-USDC

# Only set these after you confirm the official production endpoint/body/signing requirement.
SODEX_ORDER_PATH=
SODEX_API_PRIVATE_KEY=
