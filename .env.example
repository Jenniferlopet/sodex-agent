# Public data works without keys via fallback providers. Never commit real keys.
SOSOVALUE_API_KEY=
SOSOVALUE_BASE_URL=https://api.sosovalue.com
SOSOVALUE_MARKET_PATH=/openapi/v1/market/tickers
SOSOVALUE_NEWS_PATH=/openapi/v1/news/flash

SODEX_ENV=mainnet
SODEX_SPOT_ENDPOINT=https://mainnet-gw.sodex.dev/api/v1/spot
SODEX_PERPS_ENDPOINT=https://mainnet-gw.sodex.dev/api/v1/perps
SODEX_API_KEY_NAME=
SODEX_API_PRIVATE_KEY=
SODEX_ACCOUNT_ID=
SODEX_DEFAULT_SYMBOL_ID=1

# Safety gate: live order endpoint refuses unless this is true.
LIVE_TRADING=false
